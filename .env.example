# Copia este archivo como .env y rellena los valores desde
# Supabase Dashboard → Project Settings → API (proyecto baluwelboftnibtyjrer).
# El archivo .env NO debe subirse a ningún repositorio (está en .gitignore).

# URL del proyecto (pública)
SUPABASE_URL=https://baluwelboftnibtyjrer.supabase.co

# Clave pública para el cliente/app: "publishable key" (sb_publishable_...) o la "anon key" antigua.
# Es segura en el navegador SOLO si RLS está activado en todas las tablas.
SUPABASE_ANON_KEY=

# Clave de servicio: OPCIONAL. Solo para scripts de administración en servidor
# (p. ej. importar el Excel). Se salta RLS: nunca en la app ni en el navegador.
# SUPABASE_SERVICE_ROLE_KEY=
